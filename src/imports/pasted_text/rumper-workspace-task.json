    "content": [
      "Use Indonesian interface copy exactly as specified",
      "Do not describe Rumper as a property search engine",
      "Do not describe the score as AI-generated",
      "Make evidence strength and evidence gaps visible",
      "Do not imply that the system automatically makes the final buying decision"
    ],
    "architecture": {
