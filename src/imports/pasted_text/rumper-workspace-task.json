      "typography": "Clean sans-serif similar to Inter"
    },
    "layoutRules": [
      "Do not move LockedStepCard above UpgradeBanner",
      "Do not separate timeline nodes from their corresponding report cards",
      "Prevent header controls, map controls, timeline nodes, and upgrade elements from overlapping",
      "Keep factor rows compact while maintaining readable spacing",
      "Keep the right map panel stable when the factor list expands or collapses"
    ],
    "dataRules": [
      "A missing score must display '-' rather than 0",
      "RISIKO UTAMA must remain red regardless of the numerical score",
      "The flood polygon, POI markers, and radius circle must be visible in the default state",
      "A critical red flag may visually override an otherwise acceptable overall score"
    ],
    "mapRules": [
      "Do not replace the map with a chart",
      "Use a live map when available",
      "When a live map is unavailable, create a static map-like vector or image layer while keeping map controls interactive"
    ],
    "accessibility": [
      "Maintain at least WCAG AA contrast for text and controls",
      "Provide visible keyboard focus states",
      "Use keyboard-operable buttons and toggles",
      "Use semantic buttons instead of generic clickable containers",
      "Provide accessible labels for icon-only controls",
      "Do not rely on color alone to communicate evidence status or risk level"
    ],
    "completionCriteria": [
      "The desktop output closely matches the attached reference screen",
      "The vertical timeline visibly connects completed and locked stages",
      "LockedStepCard appears directly below UpgradeBanner",
      "The red Grand Galaxy polygon is visible on the map",
      "All locked interactions open the same UpgradeDrawer",
      "The initial output is complete without requiring a backend or external data source"
    ]
